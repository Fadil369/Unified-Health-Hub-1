# ──────────────────────────────────────────────────────────────────
# BrainSAIT – Unified Health Hub · Environment Variables Reference
# Copy this file to .env (never commit .env to version control)
# ──────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/brainsait

# ── Server ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Expo / React Native ───────────────────────────────────────────
EXPO_PUBLIC_DOMAIN=localhost:5000
REPLIT_DEV_DOMAIN=
REPLIT_DOMAINS=

# ── Anthropic (Claude AI – Basma assistant) ───────────────────────
AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-ant-...
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── Stripe (payment processing) ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── GitHub OAuth (via Replit Connectors) ──────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Google Cloud Storage (document uploads) ───────────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
